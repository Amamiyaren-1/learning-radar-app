# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，不要提交。
# 变量名与 config/settings.toml 中每个候选模型条目的 api_key_env 对应。

# 主分析模型（配置里的 models.analysis 指向的候选）所用的密钥
LEARNRADAR_ANALYSIS_API_KEY=

# 备用/对照候选模型（仅用于 verify-models 核验接入，不参与自动切换）
LEARNRADAR_FALLBACK_API_KEY=

# GitHub 读取令牌（可选）。不填也能读取公开仓库，但限额更低。
# 只填只读权限的细粒度令牌，不要填带写权限的令牌。
GITHUB_TOKEN=
